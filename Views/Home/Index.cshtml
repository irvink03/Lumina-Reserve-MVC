@{
    ViewData["Title"] = "Inicio";
}

<style>
    .hero-section {
        background: linear-gradient(rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.7)), url('https://images.unsplash.com/photo-1503951914875-452162b0f3f1?w=1200&q=80') center/cover no-repeat;
        height: 70vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        border-radius: 12px;
        margin-top: 10px;
        border: 1px solid #333;
    }
    .titulo-principal {
        font-size: 5rem;
        color: #d4af37;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 4px;
        margin-bottom: 10px;
        text-shadow: 2px 2px 10px rgba(0,0,0,0.8);
    }
    .subtitulo {
        font-size: 2rem;
        color: white;
        font-weight: 300;
        margin-bottom: 30px;
    }
    .hero-content p {
        font-size: 1.2rem;
        color: #ccc;
        margin-bottom: 40px;
        max-width: 700px;
        line-height: 1.6;
    }
    .btn-reservar-hero {
        background-color: #d4af37;
        color: black;
        padding: 18px 50px;
        font-size: 1.3rem;
        font-weight: bold;
        border: none;
        border-radius: 8px;
        text-decoration: none;
        transition: 0.3s;
        text-transform: uppercase;
    }
    .btn-reservar-hero:hover {
        background-color: #b5952f;
        transform: scale(1.05);
        color: black;
    }

    /* Sección de Características */
    .features-section {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-top: 40px;
        text-align: center;
        flex-wrap: wrap;
    }
    .feature-box {
        background: #1a1a1a;
        padding: 30px;
        border-radius: 12px;
        border: 1px solid #333;
        flex: 1;
        min-width: 250px;
    }
    .feature-box h3 { color: #d4af37; font-size: 1.3rem; margin-bottom: 15px; font-weight: bold;}
    
    /* Sección de Iconos Interactivos */
    .explore-section {
        margin-top: 60px;
        text-align: center;
        padding: 40px 20px;
        background: #111;
        border-radius: 12px;
        border: 1px solid #222;
    }
    .explore-title { color: white; font-size: 2rem; margin-bottom: 30px;}
    .explore-grid {
        display: flex;
        justify-content: center;
        gap: 30px;
        flex-wrap: wrap;
    }
    .icon-card {
        background: #1a1a1a;
        width: 150px;
        height: 150px;
        border-radius: 15px;
        border: 1px solid #333;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.3s;
    }
    .icon-card:hover { border-color: #d4af37; transform: translateY(-5px); background: #222;}
    .icon-card span.emoji { font-size: 3rem; margin-bottom: 10px; }
    .icon-card span.text { color: #d4af37; font-weight: bold; font-size: 1rem; }
</style>

<div class="hero-section">
    <h1 class="titulo-principal">LUMINA RESERVE</h1>
    <h2 class="subtitulo">Tu cita con el estilo, en el momento preciso</h2>
    
    <div class="hero-content">
        <p>Somos la plataforma definitiva para gestionar tus citas de barbería y cuidado personal. Evita llamadas, asegura tu lugar y vive la experiencia.</p>
        <a asp-controller="Home" asp-action="AgendarCita" class="btn-reservar-hero">Agendar Cita Ahora</a>
    </div>
</div>

<!-- Sección de Servicios e Información -->
<div class="features-section">
    <div class="feature-box">
        <h3>✂️ Expertos Locales</h3>
        <p style="color: #aaa;">Encuentra los mejores barberos y estilistas listos para definir tu estilo.</p>
    </div>
    <div class="feature-box">
        <h3>⏰ Horario de Atención</h3>
        <p style="color: #aaa;">Lunes a Sábado<br><strong>09:00 AM - 08:00 PM</strong><br>Domingos cerrado.</p>
    </div>
    <div class="feature-box">
        <h3>💳 Pagos Flexibles</h3>
        <p style="color: #aaa;">Paga directo en el local. Aceptamos efectivo, tarjetas y transferencias.</p>
    </div>
</div>

<!-- Sección Interactiva (Redirige al Modal Coming Soon) -->
<div class="explore-section">
    <h3 class="explore-title">Descubre más de nosotros</h3>
    <div class="explore-grid">
        <div class="icon-card" onclick="mostrarComingSoon()">
            <span class="emoji">📸</span>
            <span class="text">Galería de Cortes</span>
        </div>
        <div class="icon-card" onclick="mostrarComingSoon()">
            <span class="emoji">⭐</span>
            <span class="text">Reseñas</span>
        </div>
        <div class="icon-card" onclick="mostrarComingSoon()">
            <span class="emoji">💈</span>
            <span class="text">Nuestro Equipo</span>
        </div>
        <div class="icon-card" onclick="mostrarComingSoon()">
            <span class="emoji">📍</span>
            <span class="text">Ubicación</span>
        </div>
    </div>
</div>