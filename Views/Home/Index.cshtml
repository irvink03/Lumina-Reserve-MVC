@{
    ViewData["Title"] = "Inicio - Lumina Reserve";
}

<!-- Hero Section con Imagen de Fondo -->
<div class="relative bg-[#121212] text-white py-32 px-4 sm:px-6 lg:px-8 text-center border-b border-gray-800"
     style="background-image: linear-gradient(rgba(18, 18, 18, 0.8), rgba(18, 18, 18, 0.9)), url('https://images.unsplash.com/photo-1503951914875-452162b0f3f1?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80'); background-size: cover; background-position: center;">
    <div class="max-w-4xl mx-auto relative z-10">
        <h1 class="text-4xl sm:text-6xl font-bold tracking-wider uppercase mb-4 text-white drop-shadow-lg">
            LUMINA <span class="text-gold" style="color: #d4af37;">RESERVE</span>
        </h1>
        <p class="text-xl text-gray-300 italic mb-8 font-light">
            Tu cita con el estilo, en el momento preciso
        </p>
        <p class="text-gray-300 max-w-2xl mx-auto mb-10 text-base leading-relaxed">
            La plataforma definitiva para gestionar tus citas en Tuxtla Gutiérrez. Evita llamadas, asegura tu lugar en nuestras sucursales Centro o Plaza, y vive la experiencia premium.
        </p>
        <div>
            <a asp-controller="Citas" asp-action="AgendarCita" class="inline-block bg-[#d4af37] text-[#121212] font-bold px-8 py-4 rounded transition-all uppercase tracking-wide hover:bg-[#b5952f] shadow-lg hover:shadow-xl hover:-translate-y-1" style="text-decoration: none;">
                Agendar Cita Ahora
            </a>
        </div>
    </div>
</div>

<!-- Trabajos Destacados / Vista previa -->
<div class="bg-[#121212] py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-white mb-2 uppercase tracking-wide" style="color: #d4af37;">Tendencias Actuales</h2>
        <p class="text-gray-400 mb-12">Una probadita de lo que nuestros especialistas pueden hacer por ti.</p>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
            <div class="bg-[#1a1a1a] border border-gray-800 rounded-xl overflow-hidden shadow-xl hover:border-[#d4af37] transition-colors">
                <img src="~/img/Skin-Fade.jpg" alt="Skin Fade" class="w-full h-56 object-cover border-b-2 border-[#d4af37]">
                <div class="p-6">
                    <h3 class="text-xl font-bold text-white mb-2">Skin Fade</h3>
                </div>
            </div>
            <div class="bg-[#1a1a1a] border border-gray-800 rounded-xl overflow-hidden shadow-xl hover:border-[#d4af37] transition-colors">
                <img src="~/img/El-Modern-Mullet.jpg" alt="Modern Mullet" class="w-full h-56 object-cover border-b-2 border-[#d4af37]">
                <div class="p-6">
                    <h3 class="text-xl font-bold text-white mb-2">Modern Mullet</h3>
                </div>
            </div>
            <div class="bg-[#1a1a1a] border border-gray-800 rounded-xl overflow-hidden shadow-xl hover:border-[#d4af37] transition-colors">
                <img src="~/img/Corte-Permanente-Zoomer.jpg" alt="Corte Brócoli" class="w-full h-56 object-cover border-b-2 border-[#d4af37]">
                <div class="p-6">
                    <h3 class="text-xl font-bold text-white mb-2">Corte Brócoli</h3>
                </div>
            </div>
        </div>

        <div>
            <a asp-controller="Portafolio" asp-action="Portafolio" class="inline-block border border-[#d4af37] text-[#d4af37] hover:bg-[#d4af37] hover:text-[#121212] font-bold px-8 py-3 rounded transition-colors uppercase tracking-wide text-sm" style="text-decoration: none;">
                Ver catálogo completo &rarr;
            </a>
        </div>
    </div>
</div>