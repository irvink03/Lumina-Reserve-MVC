@{
    ViewData["Title"] = "Agendar Cita";
}
<style>
    .lumina-container { display: flex; flex-wrap: wrap; gap: 20px; padding: 0 20px 20px 20px; max-width: 1200px; margin: auto; }
    .card { background-color: #1a1a1a; padding: 25px; border-radius: 12px; border: 1px solid #333; }
    .col-negocio { flex: 1; min-width: 320px; }
    .col-servicios { flex: 2; min-width: 450px; }
    .col-reserva { flex: 1; min-width: 300px; background-color: #141414; }
    
    .titulo-seccion { font-size: 1.3rem; color: #d4af37; margin-bottom: 20px; border-bottom: 1px solid #333; padding-bottom: 10px; font-weight: bold;}
    
    .categoria-btn { width: 100%; background: #222; color: #d4af37; border: 1px solid #333; padding: 15px; border-radius: 8px; text-align: left; font-weight: bold; font-size: 1.1rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; transition: 0.3s;}
    .categoria-btn:hover { background: #2a2a2a; }
    .categoria-contenido { display: none; padding: 10px 0 15px 0; }
    .categoria-contenido.show { display: block; }
    
    .servicio-item { display: flex; justify-content: space-between; align-items: center; padding: 15px; border: 1px solid #333; border-radius: 8px; margin-bottom: 10px; cursor: pointer; transition: 0.3s; background: #1a1a1a;}
    .servicio-item:hover { border-color: #d4af37; background-color: #262626; }
    .servicio-item.selected { border-color: #d4af37; background-color: rgba(212, 175, 55, 0.1); }
    .precio { font-weight: bold; color: #d4af37; font-size: 1.1rem;}
    .form-check-input { width: 22px; height: 22px; margin-right: 15px; cursor: pointer; accent-color: #d4af37;}
    
    .input-grupo { margin-bottom: 20px; }
    .input-label { display: block; color: #aaa; margin-bottom: 8px; font-size: 0.9rem;}
    .input-oscuro { background: #262626; color: white; border: 1px solid #444; padding: 12px; border-radius: 6px; width: 100%; color-scheme: dark; font-family: 'Segoe UI', sans-serif; cursor: pointer; font-size: 1rem;}
    .input-oscuro:focus { outline: none; border-color: #d4af37; }
    
    .btn-confirmar { width: 100%; background: #d4af37; color: black; border: none; padding: 15px; border-radius: 8px; font-weight: bold; font-size: 1.1rem; cursor: pointer; margin-top: 20px; transition: 0.3s;}
    .btn-confirmar:hover { background: #b5952f; transform: scale(1.02);}

    /* Estilo para los selectores de sucursal */
    .radio-sucursal { display: flex; gap: 15px; margin-top: 10px; margin-bottom: 25px;}
    .radio-sucursal label { background: #262626; padding: 10px 15px; border-radius: 6px; cursor: pointer; border: 1px solid #444; color: white; display: flex; align-items: center; gap: 10px; transition: 0.2s;}
    .radio-sucursal label:hover { border-color: #d4af37;}
    .radio-sucursal input[type="radio"] { accent-color: #d4af37; width: 18px; height: 18px;}
</style>

<div class="lumina-container">
    <!-- COLUMNA 1: Info, Sucursal y Barbero -->
    <div class="col-negocio card">
        <h2 style="color: white; margin-bottom: 5px;">Lumina Reserve</h2>
        <p style="color: #888; font-size: 0.95rem;">⭐ 4.9 (120 reseñas) · Barbería Premium<br>Tuxtla Gutiérrez, Chiapas, MX</p>
        
        <h4 style="color: #d4af37; margin-top: 30px; font-size: 1.1rem; border-bottom: 1px solid #333; padding-bottom: 10px;">Tu Ubicación y Profesional</h4>
        
        <!-- NUEVO: Selector de Sucursal -->
        <label class="input-label" style="margin-top: 15px;">1. Elige tu sucursal:</label>
        <div class="radio-sucursal">
            <label>
                <input type="radio" name="sucursal" value="Centro" onchange="filtrarBarberos()" checked>
                Centro
            </label>
            <label>
                <input type="radio" name="sucursal" value="Plaza" onchange="filtrarBarberos()">
                Plaza
            </label>
        </div>

        <!-- Selector de Barbero (Se actualiza con JS) -->
        <div class="input-grupo">
            <label class="input-label">2. ¿Con quién deseas agendar?</label>
            <select id="selector-barbero" class="input-oscuro" onchange="actualizarResumen()">
                <!-- Las opciones se inyectan dinámicamente con JavaScript -->
            </select>
        </div>
        
        <div style="background: rgba(212, 175, 55, 0.1); border-left: 3px solid #d4af37; padding: 10px; margin-top: 20px;">
            <p style="color: #ccc; font-size: 0.85rem; margin: 0; line-height: 1.4;">
                <span style="color: #d4af37;">📅 <strong>Disponibilidad Inteligente:</strong></span><br>
                El sistema verificará que el barbero seleccionado esté libre en la hora elegida para evitar conflictos.
            </p>
        </div>
    </div>

    <!-- COLUMNA 2: Todos los Servicios y Horarios -->
    <div class="col-servicios card">
        <h3 class="titulo-seccion">1. Selecciona tus servicios</h3>
        
        <!-- Cortes -->
        <button class="categoria-btn" onclick="toggleCategoria('cat-cortes')">✂️ Cortes en Tendencia <span>▼</span></button>
        <div id="cat-cortes" class="categoria-contenido show">
            <label class="servicio-item"><div style="display: flex; align-items: center;"><input class="form-check-input check-corte" type="checkbox" value="Familia Fade" onchange="toggleServicioCheckbox(this, 180, 'Familia Fade')"><div><strong>Familia Fade</strong><p style="margin: 0; color: #aaa; font-size: 0.85rem;">Low, Mid, High, Taper o Burst Fade</p></div></div><div class="precio">$180</div></label>
            <label class="servicio-item"><div style="display: flex; align-items: center;"><input class="form-check-input check-corte" type="checkbox" value="Textured Crop" onchange="toggleServicioCheckbox(this, 200, 'Textured Crop')"><div><strong>Textured Crop (French)</strong><p style="margin: 0; color: #aaa; font-size: 0.85rem;">Textura desordenada y flequillo</p></div></div><div class="precio">$200</div></label>
            <label class="servicio-item"><div style="display: flex; align-items: center;"><input class="form-check-input check-corte" type="checkbox" value="Modern Mullet" onchange="toggleServicioCheckbox(this, 220, 'Modern Mullet')"><div><strong>Modern Mullet</strong><p style="margin: 0; color: #aaa; font-size: 0.85rem;">Volumen arriba y longitud en nuca</p></div></div><div class="precio">$220</div></label>
            <label class="servicio-item"><div style="display: flex; align-items: center;"><input class="form-check-input check-corte" type="checkbox" value="Corte Brócoli" onchange="toggleServicioCheckbox(this, 250, 'Corte Brócoli')"><div><strong>Corte Brócoli (Zoomer)</strong><p style="margin: 0; color: #aaa; font-size: 0.85rem;">Rizos con volumen hacia la frente</p></div></div><div class="precio">$250</div></label>
            <label class="servicio-item"><div style="display: flex; align-items: center;"><input class="form-check-input check-corte" type="checkbox" value="Buzz Cut" onchange="toggleServicioCheckbox(this, 150, 'Buzz Cut')"><div><strong>Buzz Cut (Rapado)</strong><p style="margin: 0; color: #aaa; font-size: 0.85rem;">Militar ultra corto con degradado</p></div></div><div class="precio">$150</div></label>
            <label class="servicio-item"><div style="display: flex; align-items: center;"><input class="form-check-input check-corte" type="checkbox" value="Quiff Texturizado" onchange="toggleServicioCheckbox(this, 200, 'Quiff Texturizado')"><div><strong>Quiff Texturizado</strong><p style="margin: 0; color: #aaa; font-size: 0.85rem;">Acabado mate, despeinado y volumen</p></div></div><div class="precio">$200</div></label>
        </div>

        <!-- Barbas -->
        <button class="categoria-btn" onclick="toggleCategoria('cat-barba')">🧔 Arreglo de Barba <span>▼</span></button>
        <div id="cat-barba" class="categoria-contenido">
            <label class="servicio-item"><div style="display: flex; align-items: center;"><input class="form-check-input" type="checkbox" value="Perfilado de Barba" onchange="toggleServicioCheckbox(this, 150, 'Perfilado de Barba')"><div><strong>Perfilado de Barba</strong><p style="margin: 0; color: #aaa; font-size: 0.85rem;">Alineación perfecta con navaja</p></div></div><div class="precio">$150</div></label>
            <label class="servicio-item"><div style="display: flex; align-items: center;"><input class="form-check-input" type="checkbox" value="Barba Premium" onchange="toggleServicioCheckbox(this, 200, 'Barba Premium')"><div><strong>Barba Premium con Toalla</strong><p style="margin: 0; color: #aaa; font-size: 0.85rem;">Toalla caliente, aceites y masaje</p></div></div><div class="precio">$200</div></label>
        </div>

        <!-- Faciales -->
        <button class="categoria-btn" onclick="toggleCategoria('cat-faciales')">💆 Masajes y Faciales <span>▼</span></button>
        <div id="cat-faciales" class="categoria-contenido">
            <label class="servicio-item"><div style="display: flex; align-items: center;"><input class="form-check-input" type="checkbox" value="Limpieza Express" onchange="toggleServicioCheckbox(this, 180, 'Limpieza Express')"><div><strong>Limpieza Facial Express</strong><p style="margin: 0; color: #aaa; font-size: 0.85rem;">Exfoliación y mascarilla negra</p></div></div><div class="precio">$180</div></label>
            <label class="servicio-item"><div style="display: flex; align-items: center;"><input class="form-check-input" type="checkbox" value="Facial Completo" onchange="toggleServicioCheckbox(this, 300, 'Facial Completo + Masaje')"><div><strong>Facial Completo + Masaje</strong><p style="margin: 0; color: #aaa; font-size: 0.85rem;">Limpieza profunda y masaje relajante</p></div></div><div class="precio">$300</div></label>
        </div>

        <!-- Combos -->
        <button class="categoria-btn" onclick="toggleCategoria('cat-combos')">🔥 Combos Especiales <span>▼</span></button>
        <div id="cat-combos" class="categoria-contenido">
            <label class="servicio-item"><div style="display: flex; align-items: center;"><input class="form-check-input" type="checkbox" value="Combo Ejecutivo" onchange="toggleServicioCheckbox(this, 350, 'Combo Ejecutivo')"><div><strong>Combo Ejecutivo</strong><p style="margin: 0; color: #aaa; font-size: 0.85rem;">Corte Fade + Perfilado de Barba</p></div></div><div class="precio">$350</div></label>
            <label class="servicio-item"><div style="display: flex; align-items: center;"><input class="form-check-input" type="checkbox" value="Ritual VIP" onchange="toggleServicioCheckbox(this, 650, 'Ritual Lumina VIP')"><div><strong>Ritual Lumina VIP</strong><p style="margin: 0; color: #aaa; font-size: 0.85rem;">Corte + Barba Premium + Facial Completo</p></div></div><div class="precio">$650</div></label>
        </div>

        <h3 class="titulo-seccion" style="margin-top: 40px;">2. Fecha y hora de tu cita</h3>
        <div style="display: flex; gap: 20px; flex-wrap: wrap;">
            <div class="input-grupo" style="flex: 1; min-width: 200px;">
                <label class="input-label">Elige la fecha:</label>
                <input type="date" id="selector-fecha" class="input-oscuro" onchange="validarDisponibilidad()">
            </div>
            <div class="input-grupo" style="flex: 1; min-width: 200px;">
                <label class="input-label">Elige la hora:</label>
                <input type="time" id="selector-hora" class="input-oscuro" value="16:00" onchange="validarDisponibilidad()">
            </div>
        </div>
        <p id="alerta-ocupado" style="color: #ff4d4d; font-size: 0.95rem; display: none; margin-top: 15px; padding: 10px; background: rgba(255,0,0,0.1); border-left: 3px solid #ff4d4d;">⚠️ <strong>Horario no disponible.</strong> El barbero seleccionado ya tiene una cita a esa hora. Elige otra.</p>
    </div>

    <!-- COLUMNA 3: Resumen -->
    <div class="col-reserva card">
        <h3 class="titulo-seccion">Tu reserva</h3>
        
        <p style="color: #aaa; font-size: 0.9rem; margin: 5px 0;">SUCURSAL</p>
        <p id="resumen-sucursal" style="font-weight: bold; margin: 0 0 15px 0; font-size: 1.1rem; color: #fff;">Centro</p>

        <p style="color: #aaa; font-size: 0.9rem; margin: 5px 0;">BARBERO SELECCIONADO</p>
        <p id="resumen-barbero" style="font-weight: bold; margin: 0 0 15px 0; font-size: 1.1rem; color: #d4af37;">Cualquier barbero disponible</p>

        <p style="color: #aaa; font-size: 0.9rem; margin: 5px 0;">SERVICIOS</p>
        <p id="resumen-servicios" style="font-weight: bold; margin: 0 0 15px 0; font-size: 0.95rem; color: #fff;">Ningún servicio seleccionado</p>
        
        <p style="color: #aaa; font-size: 0.9rem; margin: 5px 0;">FECHA Y HORA</p>
        <p id="resumen-fecha-hora" style="font-weight: bold; margin: 0 0 20px 0; color: #fff;">Selecciona una fecha y hora</p>
        
        <hr style="border-color: #333; margin-bottom: 20px;">
        <div style="display: flex; justify-content: space-between; font-size: 1.3rem; margin-bottom: 15px;">
            <span style="color: white;">Total</span>
            <span class="precio" id="resumen-total">$0</span>
        </div>
        <button class="btn-confirmar" id="btn-submit">Confirmar reserva</button>
    </div>
</div>

<script>
    let total = 0;
    let serviciosSeleccionados = [];

    // --- BASE DE DATOS LOCAL DE BARBEROS ---
    const barberosPorSucursal = {
        "Centro": [
            { nombre: "Cualquier barbero disponible", valor: "Cualquier barbero disponible" },
            { nombre: "Irvin Chavarría (Cortes urbanos / Fade)", valor: "Irvin Chavarría" },
            { nombre: "Fernando Rodríguez (Cortes clásicos / Barba)", valor: "Fernando Rodríguez" },
            { nombre: "Geovany Iván (Masajes / Rituales VIP)", valor: "Geovany Iván" }
        ],
        "Plaza": [
            { nombre: "Cualquier barbero disponible", valor: "Cualquier barbero disponible" },
            { nombre: "Diego Silva (Colorimetría / Faciales)", valor: "Diego Silva" },
            { nombre: "Erick Ulises (Diseño / Freestyle)", valor: "Erick Ulises" }
        ]
    };

    // Filtra el select dependiendo del radio button
    function filtrarBarberos(barberoSeleccionadoPorUrl = null) {
        const sucursalElegida = document.querySelector('input[name="sucursal"]:checked').value;
        const selectorBarbero = document.getElementById('selector-barbero');
        
        // Limpiamos el select
        selectorBarbero.innerHTML = '';
        
        // Llenamos el select con los barberos de esa sucursal
        barberosPorSucursal[sucursalElegida].forEach(barbero => {
            let option = document.createElement('option');
            option.value = barbero.valor;
            option.text = barbero.nombre;
            selectorBarbero.appendChild(option);
        });

        // Actualiza el resumen de sucursal
        document.getElementById('resumen-sucursal').innerText = sucursalElegida;

        // Si venimos de la URL con un barbero específico, intentamos seleccionarlo
        if (barberoSeleccionadoPorUrl && barberoSeleccionadoPorUrl !== 'Cualquier barbero') {
            for(let i=0; i<selectorBarbero.options.length; i++) {
                if(selectorBarbero.options[i].value === barberoSeleccionadoPorUrl) {
                    selectorBarbero.selectedIndex = i;
                    break;
                }
            }
        }

        actualizarResumen();
    }

    // Funciones de servicios y UX
    function toggleCategoria(idCategoria) {
        const contenido = document.getElementById(idCategoria);
        if (contenido.classList.contains('show')) { contenido.classList.remove('show'); } 
        else { contenido.classList.add('show'); }
    }

    function toggleServicioCheckbox(checkbox, precio, nombreServicio) {
        let elemento = checkbox.closest('.servicio-item');
        if (checkbox.checked) {
            elemento.classList.add('selected');
            total += precio;
            serviciosSeleccionados.push(nombreServicio);
        } else {
            elemento.classList.remove('selected');
            total -= precio;
            serviciosSeleccionados = serviciosSeleccionados.filter(s => s !== nombreServicio);
        }
        document.getElementById('resumen-total').innerText = '$' + total;
        document.getElementById('resumen-servicios').innerHTML = serviciosSeleccionados.length > 0 ? serviciosSeleccionados.join('<br>') : 'Ningún servicio seleccionado';
    }

    function actualizarResumen() {
        const selector = document.getElementById('selector-barbero');
        document.getElementById('resumen-barbero').innerText = selector.value;
        validarDisponibilidad();
    }

    function validarDisponibilidad() {
        const fechaVal = document.getElementById('selector-fecha').value;
        const horaVal = document.getElementById('selector-hora').value;
        const alerta = document.getElementById('alerta-ocupado');
        const btnSubmit = document.getElementById('btn-submit');
        
        if (horaVal === "14:00") {
            alerta.style.display = 'block';
            btnSubmit.style.background = '#333';
            btnSubmit.style.color = '#666';
            btnSubmit.style.cursor = 'not-allowed';
            btnSubmit.innerText = 'Barbero no disponible';
            btnSubmit.disabled = true;
        } else {
            alerta.style.display = 'none';
            btnSubmit.style.background = '#d4af37';
            btnSubmit.style.color = 'black';
            btnSubmit.style.cursor = 'pointer';
            btnSubmit.innerText = 'Confirmar reserva';
            btnSubmit.disabled = false;
        }

        if(fechaVal && horaVal) {
            const opciones = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' };
            const fechaObj = new Date(fechaVal + 'T00:00:00');
            const fechaFormateada = fechaObj.toLocaleDateString('es-MX', opciones);
            document.getElementById('resumen-fecha-hora').innerText = fechaFormateada + ', ' + horaVal + ' hrs';
        }
    }

    // Al cargar la página
    document.addEventListener("DOMContentLoaded", function() {
        const inputFecha = document.getElementById('selector-fecha');
        const hoy = new Date().toISOString().split('T')[0];
        inputFecha.value = hoy; inputFecha.min = hoy; 

        // 1. Verificar si viene un barbero de la URL y seleccionar su sucursal automáticamente
        let barberoUrl = '@Html.Raw(ViewBag.Barbero)';
        
        if (barberoUrl && barberoUrl !== 'Cualquier barbero') {
            // Buscamos en qué sucursal está el barbero que viene en la URL
            if (barberosPorSucursal["Centro"].some(b => b.valor === barberoUrl)) {
                document.querySelector('input[value="Centro"]').checked = true;
            } else if (barberosPorSucursal["Plaza"].some(b => b.valor === barberoUrl)) {
                document.querySelector('input[value="Plaza"]').checked = true;
            }
        }
        
        // Inicializamos los barberos según la sucursal que quedó seleccionada
        filtrarBarberos(barberoUrl); 

        // 2. Auto-seleccionar el corte si viene por URL
        let corteUrl = '@Html.Raw(ViewBag.Corte)';
        if(corteUrl) {
            let checkboxes = document.querySelectorAll('.check-corte');
            checkboxes.forEach(cb => {
                if(cb.value === corteUrl) {
                    cb.checked = true;
                    toggleServicioCheckbox(cb, parseInt(cb.closest('.servicio-item').querySelector('.precio').innerText.replace('$','')), corteUrl);
                }
            });
        }
    });
</script>