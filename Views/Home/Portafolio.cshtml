@{
    ViewData["Title"] = "Portafolio de Cortes";
}
<style>
    .portfolio-container { max-width: 1200px; margin: auto; padding: 40px 20px; text-align: center; }
    .portfolio-title { color: #d4af37; font-size: 2.5rem; font-weight: bold; margin-bottom: 10px; }
    .portfolio-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 30px; margin-top: 40px;}
    .cut-card { background: #1a1a1a; border: 1px solid #333; border-radius: 12px; width: 350px; text-align: left; overflow: hidden; display: flex; flex-direction: column; transition: 0.3s;}
    .cut-card:hover { border-color: #d4af37; box-shadow: 0 5px 15px rgba(0,0,0,0.5); }
    .cut-img { width: 100%; height: 250px; object-fit: cover; border-bottom: 2px solid #d4af37; cursor: zoom-in; transition: 0.3s;}
    .cut-img:hover { filter: brightness(1.1); }
    .cut-info { padding: 20px; flex-grow: 1; display: flex; flex-direction: column;}
    .cut-name { color: #d4af37; font-size: 1.4rem; font-weight: bold; margin-bottom: 10px; }
    .cut-desc { color: #aaa; font-size: 0.9rem; line-height: 1.5; margin-bottom: 25px; flex-grow: 1;}
    .btn-group-corte { display: flex; gap: 10px; margin-top: auto;}
    .btn-ver-foto { flex: 1; background: transparent; color: white; border: 1px solid #555; padding: 10px; border-radius: 6px; font-weight: bold; text-align: center; cursor: pointer; transition: 0.3s; font-size: 0.95rem;}
    .btn-ver-foto:hover { border-color: white; background: #222; color: white; }
    .btn-elegir { flex: 1; background: #d4af37; color: black; border: none; padding: 10px; border-radius: 6px; font-weight: bold; text-align: center; text-decoration: none; transition: 0.3s; font-size: 0.95rem;}
    .btn-elegir:hover { background: #b5952f; color: black; }

    /* Modal de foto en grande */
    .modal-foto-ampliada { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 2000; justify-content: center; align-items: center; flex-direction: column; }
    .modal-foto-ampliada img { max-width: 90%; max-height: 75vh; border-radius: 12px; border: 2px solid #d4af37; object-fit: contain;}
    .modal-foto-titulo { color: #d4af37; font-size: 1.8rem; margin-top: 20px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;}
    .btn-cerrar-foto { position: absolute; top: 20px; right: 40px; font-size: 3rem; color: white; cursor: pointer; background: none; border: none; font-weight: bold; transition: 0.2s;}
    .btn-cerrar-foto:hover { color: #ff4d4d; transform: scale(1.1);}
</style>

<div class="portfolio-container">
    <h1 class="portfolio-title">Estilos en Tendencia por @ViewBag.Barbero</h1>
    <p style="color: #ccc;">Explora nuestros trabajos. Haz clic en la imagen para ver los detalles sin compromiso.</p>

    <div class="portfolio-grid">
        <!-- 1. FADE -->
        <div class="cut-card">
            <img src="~/img/Skin-Fade.jpg" alt="Familia Fade" class="cut-img" onclick="abrirFoto('@Url.Content("~/img/Skin-Fade.jpg")', 'La familia Fade')">
            <div class="cut-info">
                <h3 class="cut-name">La familia "Fade" (Degradado)</h3>
                <p class="cut-desc">Técnica de desvanecimiento en laterales y nuca. Variantes pedidas: Low, Mid y High Fade, Taper Fade (solo patillas/nuca), Skin Fade (hasta la piel) y Burst Fade (semicírculo).</p>
                <div class="btn-group-corte">
                    <button class="btn-ver-foto" onclick="abrirFoto('@Url.Content("~/img/Skin-Fade.jpg")', 'La familia Fade')">🔍 Ver imagen</button>
                    <!-- Manda la orden "Fade Degradado" a AgendarCita -->
                    <a asp-controller="Home" asp-action="AgendarCita" asp-route-barbero="@ViewBag.Barbero" asp-route-corte="Fade Degradado" class="btn-elegir">📅 Agendar</a>
                </div>
            </div>
        </div>

        <!-- 2. TEXTURED CROP -->
        <div class="cut-card">
            <img src="~/img/El-Textured-Crop.jpg" alt="Textured Crop" class="cut-img" onclick="abrirFoto('@Url.Content("~/img/El-Textured-Crop.jpg")', 'Textured Crop')">
            <div class="cut-info">
                <h3 class="cut-name">Textured Crop (French Crop)</h3>
                <p class="cut-desc">Laterales muy cortos con textura desordenada arriba y flequillo hacia adelante. Perfecto para disimular frentes amplias. Base del popular "Edgar Cut".</p>
                <div class="btn-group-corte">
                    <button class="btn-ver-foto" onclick="abrirFoto('@Url.Content("~/img/El-Textured-Crop.jpg")', 'Textured Crop')">🔍 Ver imagen</button>
                    <a asp-controller="Home" asp-action="AgendarCita" asp-route-barbero="@ViewBag.Barbero" asp-route-corte="Textured Crop" class="btn-elegir">📅 Agendar</a>
                </div>
            </div>
        </div>

        <!-- 3. MODERN MULLET -->
        <div class="cut-card">
            <img src="~/img/El-Modern-Mullet.jpg" alt="Modern Mullet" class="cut-img" onclick="abrirFoto('@Url.Content("~/img/El-Modern-Mullet.jpg")', 'Modern Mullet')">
            <div class="cut-info">
                <h3 class="cut-name">Modern Mullet</h3>
                <p class="cut-desc">El clásico de los 80. Mantiene volumen en la parte superior y longitud en la nuca, modernizado con un burst fade en los laterales. Atrevido y con mucho carácter.</p>
                <div class="btn-group-corte">
                    <button class="btn-ver-foto" onclick="abrirFoto('@Url.Content("~/img/El-Modern-Mullet.jpg")', 'Modern Mullet')">🔍 Ver imagen</button>
                    <a asp-controller="Home" asp-action="AgendarCita" asp-route-barbero="@ViewBag.Barbero" asp-route-corte="Modern Mullet" class="btn-elegir">📅 Agendar</a>
                </div>
            </div>
        </div>

        <!-- 4. CORTE BRÓCOLI -->
        <div class="cut-card">
            <img src="~/img/Corte-Permanente-Zoomer.jpg" alt="Corte Brócoli" class="cut-img" onclick="abrirFoto('@Url.Content("~/img/Corte-Permanente-Zoomer.jpg")', 'Corte Brócoli')">
            <div class="cut-info">
                <h3 class="cut-name">Corte "Brócoli" (Zoomer)</h3>
                <p class="cut-desc">Favorito de la Generación Z. Laterales cortos con degradado y parte superior llena de rizos desordenados con mucho volumen hacia la frente. Ideal con bases o permanentes.</p>
                <div class="btn-group-corte">
                    <button class="btn-ver-foto" onclick="abrirFoto('@Url.Content("~/img/Corte-Permanente-Zoomer.jpg")', 'Corte Brócoli')">🔍 Ver imagen</button>
                    <a asp-controller="Home" asp-action="AgendarCita" asp-route-barbero="@ViewBag.Barbero" asp-route-corte="Corte Brócoli" class="btn-elegir">📅 Agendar</a>
                </div>
            </div>
        </div>

        <!-- 5. BUZZ CUT -->
        <div class="cut-card">
            <img src="~/img/El-Buzz-Cut.jpg" alt="Buzz Cut" class="cut-img" onclick="abrirFoto('@Url.Content("~/img/El-Buzz-Cut.jpg")', 'Buzz Cut')">
            <div class="cut-info">
                <h3 class="cut-name">Buzz Cut (Rapado)</h3>
                <p class="cut-desc">Estilo militar ultra corto y de longitud uniforme arriba (1 a 4 mm), combinado con un degradado en los laterales. Ideal para un bajo mantenimiento o deportistas.</p>
                <div class="btn-group-corte">
                    <button class="btn-ver-foto" onclick="abrirFoto('@Url.Content("~/img/El-Buzz-Cut.jpg")', 'Buzz Cut')">🔍 Ver imagen</button>
                    <a asp-controller="Home" asp-action="AgendarCita" asp-route-barbero="@ViewBag.Barbero" asp-route-corte="Buzz Cut" class="btn-elegir">📅 Agendar</a>
                </div>
            </div>
        </div>

        <!-- 6. QUIFF TEXTURIZADO -->
        <div class="cut-card">
            <img src="~/img/El-Quiff-Texturizado.jpg" alt="Quiff Texturizado" class="cut-img" onclick="abrirFoto('@Url.Content("~/img/El-Quiff-Texturizado.jpg")', 'Quiff Texturizado')">
            <div class="cut-info">
                <h3 class="cut-name">Quiff Texturizado</h3>
                <p class="cut-desc">Evolución del pompadour. Volumen en la delantera peinado hacia arriba y atrás, pero con un acabado mate, despeinado y texturizado en lugar de fijadores brillantes.</p>
                <div class="btn-group-corte">
                    <button class="btn-ver-foto" onclick="abrirFoto('@Url.Content("~/img/El-Quiff-Texturizado.jpg")', 'Quiff Texturizado')">🔍 Ver imagen</button>
                    <a asp-controller="Home" asp-action="AgendarCita" asp-route-barbero="@ViewBag.Barbero" asp-route-corte="Quiff Texturizado" class="btn-elegir">📅 Agendar</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="modalVisorFoto" class="modal-foto-ampliada">
    <button class="btn-cerrar-foto" onclick="cerrarFoto()">&times;</button>
    <img id="imagenModal" src="" alt="Corte Ampliado">
    <h3 id="tituloModal" class="modal-foto-titulo"></h3>
</div>

<script>
    function abrirFoto(rutaImagen, nombreCorte) {
        document.getElementById('imagenModal').src = rutaImagen;
        document.getElementById('tituloModal').innerText = nombreCorte;
        document.getElementById('modalVisorFoto').style.display = 'flex';
    }
    function cerrarFoto() {
        document.getElementById('modalVisorFoto').style.display = 'none';
        document.getElementById('imagenModal').src = '';
    }
    document.getElementById('modalVisorFoto').addEventListener('click', function(e) {
        if(e.target === this) { cerrarFoto(); }
    });
</script>