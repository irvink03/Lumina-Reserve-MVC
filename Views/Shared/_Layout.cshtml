<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lumina Reserve</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { background-color: #0d0d0d; color: #f1f1f1; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        
        /* ---------------------------------------------------
           BARRA DE NAVEGACIÓN TOTALMENTE PERSONALIZADA
           --------------------------------------------------- */
        .navbar-lumina { 
            background-color: #1a1a1a; 
            border-bottom: 1px solid #333; 
            padding: 15px 40px;
            display: flex; /* Esto empuja los elementos a los lados */
            justify-content: space-between; /* Izquierda y Derecha */
            align-items: center;
        }
        
        /* Logo a la izquierda */
        .navbar-brand-lumina { 
            color: #d4af37 !important; 
            font-weight: 900; 
            font-size: 1.8rem; 
            text-transform: uppercase; 
            letter-spacing: 3px; 
            text-decoration: none;
        }
        .navbar-brand-lumina:hover { color: #fff !important; }

        /* Contenedor de botones a la derecha */
        .nav-links-lumina { 
            display: flex; 
            gap: 15px; 
            align-items: center;
            margin: 0;
            padding: 0;
            list-style: none; /* Quita los puntos de lista */
        }
        
        /* Botones normales */
        .nav-link-lumina { 
            color: #ccc !important; 
            font-weight: bold; 
            font-size: 1.1rem; 
            text-decoration: none; 
            transition: 0.3s; 
            padding: 8px 15px; 
            border-radius: 6px;
        }
        .nav-link-lumina:hover { 
            color: #d4af37 !important; 
            background: rgba(212, 175, 55, 0.1);
        }

        /* Botón especial de Agendar */
        .btn-nav-agendar { 
            background-color: transparent; 
            color: #d4af37 !important; 
            border: 2px solid #d4af37; 
            padding: 8px 25px !important; 
            border-radius: 6px; 
            transition: 0.3s; 
            margin-left: 10px;
            text-transform: uppercase;
        }
        .btn-nav-agendar:hover { 
            background-color: #d4af37 !important; 
            color: black !important; 
        }

        footer { background-color: #1a1a1a; color: #888; border-top: 1px solid #333; text-align: center; padding: 20px 0; margin-top: 50px; }
    </style>
</head>
<body>
    <header>
        <!-- Aquí aplicamos la nueva barra -->
        <nav class="navbar-lumina">
            <!-- 1. Nombre a la izquierda -->
            <a class="navbar-brand-lumina" asp-controller="Home" asp-action="Index">LUMINA RESERVE</a>

            <!-- 2. Botones a la derecha -->
            <ul class="nav-links-lumina">
                <li><a class="nav-link-lumina" asp-controller="Home" asp-action="NuestroEquipo">Equipo</a></li>
                <li><a class="nav-link-lumina" asp-controller="Home" asp-action="Portafolio">Fotos / Trabajos</a></li>
                <li><a class="nav-link-lumina" asp-controller="Home" asp-action="Ubicacion">Ubicación</a></li>
                
                <!-- Enlace de Reseñas añadido -->
                <!-- Enlace de Reseñas apuntando al nuevo controlador -->
                <li><a class="nav-link-lumina" asp-controller="Resenas" asp-action="Index">Reseñas</a></li>
                
                <li><a class="nav-link-lumina btn-nav-agendar" asp-controller="Home" asp-action="AgendarCita">Agendar Cita</a></li>
            </ul>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            <!-- Aquí se inyecta el contenido de Index, AgendarCita, etc. -->
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container">
            &copy; 2026 - Lumina Reserve - Tuxtla Gutiérrez, Chiapas
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>