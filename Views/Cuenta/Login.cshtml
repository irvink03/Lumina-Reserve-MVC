@{
    ViewData["Title"] = "Acceso a tu Cuenta";
}

<div class="bg-[#121212] min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 border-t border-gray-800">
    <div class="max-w-md w-full bg-[#1a1a1a] p-8 rounded-xl shadow-2xl border border-gray-800">
        
        <div class="text-center mb-8">
            <h2 class="text-3xl font-bold text-white uppercase tracking-widest mb-1">
                LUMINA <span class="text-[#d4af37]">RESERVE</span>
            </h2>
            <p class="text-gray-400 text-sm">Inicia sesión o crea tu cuenta para agendar</p>
        </div>

        <form class="space-y-6" action="#" method="POST">
            <div>
                <label class="block text-sm font-medium text-gray-400 mb-1">Correo Electrónico</label>
                <input type="email" class="w-full bg-[#262626] border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-[#d4af37] transition-colors" placeholder="tu@correo.com">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-400 mb-1">Contraseña</label>
                <input type="password" class="w-full bg-[#262626] border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-[#d4af37] transition-colors" placeholder="••••••••">
            </div>

            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <input id="remember-me" type="checkbox" class="h-4 w-4 rounded bg-[#262626] border-gray-700 text-[#d4af37] focus:ring-[#d4af37]">
                    <label for="remember-me" class="ml-2 block text-sm text-gray-400">Recordarme</label>
                </div>
                <div class="text-sm">
                    <a href="#" class="font-medium text-[#d4af37] hover:text-[#b5952f]" style="text-decoration: none;">¿Olvidaste tu contraseña?</a>
                </div>
            </div>

            <div>
                <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-bold text-black bg-[#d4af37] hover:bg-[#b5952f] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#d4af37] uppercase tracking-wide transition-colors">
                    Iniciar Sesión
                </button>
            </div>
        </form>

        <div class="mt-8 text-center border-t border-gray-800 pt-6">
            <p class="text-gray-400 text-sm">
                ¿No tienes una cuenta? 
                <a href="#" class="font-bold text-white hover:text-[#d4af37] transition-colors" style="text-decoration: none;">Regístrate ahora</a>
            </p>
        </div>
    </div>
</div>