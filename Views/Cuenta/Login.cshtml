@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="flex items-center justify-center min-h-[80vh] px-4 py-12">
    <div class="bg-[#1a1a1a] border border-gray-800 p-8 rounded-2xl shadow-2xl w-full max-w-md">
        
        <h2 class="text-2xl font-bold text-center text-[#d4af37] mb-6 tracking-wide">Iniciar Sesión</h2>

        @if (TempData["Error"] != null)
        {
            <div class="bg-red-900 bg-opacity-30 border border-red-500 text-red-300 px-4 py-3 rounded-lg mb-6 text-sm text-center">
                @TempData["Error"]
            </div>
        }
        @if (TempData["Exito"] != null)
        {
            <div class="bg-green-900 bg-opacity-30 border border-green-500 text-green-300 px-4 py-3 rounded-lg mb-6 text-sm text-center">
                @TempData["Exito"]
            </div>
        }

        <form asp-controller="Cuenta" asp-action="Login" method="post" class="space-y-5">
            <div>
                <label class="block text-gray-400 text-sm mb-2 font-medium">Correo Electrónico</label>
                <input type="email" name="correo" class="w-full bg-[#262626] text-white border border-gray-700 rounded-lg px-4 py-3 focus:outline-none focus:border-[#d4af37] transition-colors" placeholder="tucorreo@email.com" required />
            </div>

            <div>
                <label class="block text-gray-400 text-sm mb-2 font-medium">Contraseña</label>
                <input type="password" name="password" class="w-full bg-[#262626] text-white border border-gray-700 rounded-lg px-4 py-3 focus:outline-none focus:border-[#d4af37] transition-colors" placeholder="••••••••" required />
            </div>

            <div>
                <label class="block text-gray-400 text-sm mb-2 font-medium">Código de Verificación (Telegram Bot)</label>
                <input type="text" name="codigoBot" class="w-full bg-[#262626] text-white border border-gray-700 rounded-lg px-4 py-3 focus:outline-none focus:border-[#d4af37] transition-colors" placeholder="Ej. 849201" required />
                <p class="text-gray-500 text-xs mt-1">Solicita tu código temporal enviando tu correo a nuestro bot de Telegram.</p>
            </div>

            <button type="submit" class="w-full bg-[#d4af37] text-black font-bold py-3 rounded-lg hover:bg-[#b5952f] transition-colors shadow-lg mt-2">
                Entrar
            </button>
        </form>

        <div class="text-center mt-6">
            <p class="text-gray-400 text-sm">¿No tienes cuenta? <a asp-action="Registro" class="text-[#d4af37] hover:underline font-medium">Regístrate aquí</a></p>
        </div>
    </div>
</div>