@model IEnumerable<Lumina_Reserve_MVC.Models.Corte>
@{
    ViewData["Title"] = "Agendar Cita";
    var barberoSeleccionado = Context.Request.Query["barbero"].ToString();
    var corteSeleccionado = Context.Request.Query["corte"].ToString();

    // Extraemos las listas que mandamos desde el controlador
    var sucursales = ViewBag.Sucursales as List<Lumina_Reserve_MVC.Models.Sucursale> ?? new List<Lumina_Reserve_MVC.Models.Sucursale>();
    var barberos = ViewBag.Barberos as List<Lumina_Reserve_MVC.Models.Empleado> ?? new List<Lumina_Reserve_MVC.Models.Empleado>();
    var cortes = ViewBag.Cortes as List<Lumina_Reserve_MVC.Models.Corte> ?? new List<Lumina_Reserve_MVC.Models.Corte>();
    var categorias = cortes?.Select(c => c.Categoria).Distinct().ToList() ?? new List<string>();

    // Barberos agrupados por sucursal, listos para convertirse en JSON (respeta acentos)
    var barberosPorSucursalData = barberos
        .GroupBy(b => b.Sucursal.Nombre)
        .ToDictionary(
            g => g.Key,
            g => new[] { new { nombre = "Cualquier barbero disponible", valor = "" } }
                .Concat(g.Select(b => new { nombre = b.Usuario.NombreCompleto + " - " + b.Especialidad, valor = b.Id.ToString() }))
                .ToList());
}

<!-- Tus estilos originales sin tocar -->
<style>
    .lumina-container { display: flex; flex-wrap: wrap; gap: 20px; padding: 0 20px 20px 20px; max-width: 1200px; margin: auto; }
    .card { background-color: #1a1a1a; padding: 25px; border-radius: 12px; border: 1px solid #333; }
    .col-negocio { flex: 1; min-width: 320px; }
    .col-servicios { flex: 2; min-width: 450px; }
    .col-reserva { flex: 1; min-width: 300px; background-color: #141414; }
    .titulo-seccion { font-size: 1.3rem; color: #d4af37; margin-bottom: 20px; border-bottom: 1px solid #333; padding-bottom: 10px; font-weight: bold;}
    .categoria-btn { width: 100%; background: #222; color: #d4af37; border: 1px solid #333; padding: 15px; border-radius: 8px; text-align: left; font-weight: bold; font-size: 1.1rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; transition: 0.3s;}
    .categoria-btn:hover { background: #2a2a2a; }
    .categoria-contenido { display: none; padding: 10px 0 15px 0; }
    .categoria-contenido.show { display: block; }
    .servicio-item { display: flex; justify-content: space-between; align-items: center; padding: 15px; border: 1px solid #333; border-radius: 8px; margin-bottom: 10px; cursor: pointer; transition: 0.3s; background: #1a1a1a;}
    .servicio-item:hover { border-color: #d4af37; background-color: #262626; }
    .servicio-item.selected { border-color: #d4af37; background-color: rgba(212, 175, 55, 0.1); }
    .precio { font-weight: bold; color: #d4af37; font-size: 1.1rem;}
    .form-check-input { width: 22px; height: 22px; margin-right: 15px; cursor: pointer; accent-color: #d4af37;}
    .input-grupo { margin-bottom: 20px; }
    .input-label { display: block; color: #aaa; margin-bottom: 8px; font-size: 0.9rem;}
    .input-oscuro { background: #262626; color: white; border: 1px solid #444; padding: 12px; border-radius: 6px; width: 100%; color-scheme: dark; font-family: 'Segoe UI', sans-serif; font-size: 1rem;}
    .input-oscuro:focus { outline: none; border-color: #d4af37; }
    .btn-confirmar { width: 100%; background: #d4af37; color: black; border: none; padding: 15px; border-radius: 8px; font-weight: bold; font-size: 1.1rem; cursor: pointer; margin-top: 20px; transition: 0.3s;}
    .btn-confirmar:hover { background: #b5952f; transform: scale(1.02);}
    .radio-sucursal { display: flex; gap: 15px; margin-top: 10px; margin-bottom: 15px;}
    .radio-sucursal label { background: #262626; padding: 10px 15px; border-radius: 6px; cursor: pointer; border: 1px solid #444; color: white; display: flex; align-items: center; gap: 10px; transition: 0.2s;}
    .radio-sucursal label:hover { border-color: #d4af37;}
    .radio-sucursal input[type="radio"] { accent-color: #d4af37; width: 18px; height: 18px;}
    .distribucion-equipos { background: #111; padding: 10px; border-radius: 6px; font-size: 0.85rem; color: #888; margin-bottom: 25px; border: 1px dashed #333;}
</style>

<!-- ALERTAS DINÁMICAS -->
@if (TempData["Exito"] != null)
{
    <div class="alert alert-success" style="background-color: #28a745; color: white; padding: 15px; margin-bottom: 20px; border-radius: 5px; text-align: center; max-width: 1200px; margin: 0 auto 20px auto;">
        @TempData["Exito"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="background-color: #dc3545; color: white; padding: 15px; margin-bottom: 20px; border-radius: 5px; text-align: center; max-width: 1200px; margin: 0 auto 20px auto;">
        @TempData["Error"]
    </div>
}

<!-- EL FORMULARIO ENVUELVE TODO TU CÓDIGO HTML -->
<form asp-controller="Citas" asp-action="ConfirmarReserva" method="post" id="formulario-cita">
    <div class="lumina-container">
        
        <!-- COLUMNA 1: SUCURSAL Y BARBERO -->
        <div class="col-negocio card">
            <h2 style="color: white; margin-bottom: 5px;">Lumina Reserve</h2>
            <p style="color: #888; font-size: 0.95rem;">
                <span style="color:#d4af37">&#9733; 4.9 (120 reseñas)</span> - Barbería Premium<br>Tuxtla Gutiérrez, Chiapas, MX
            </p>

            <h4 style="color: #d4af37; margin-top: 30px; font-size: 1.1rem; border-bottom: 1px solid #333; padding-bottom: 10px;">Tu Ubicación y Profesional</h4>
            <label class="input-label" style="margin-top: 15px;">1. Elige tu sucursal:</label>
            
            <div class="radio-sucursal">
                @foreach(var sucursal in sucursales)
                {
                    <label>
                        <!-- Agregado name="SucursalId" y value dinámico -->
                        <input type="radio" name="SucursalId" value="@sucursal.Id" onchange="filtrarBarberos()" @(sucursal.Nombre == "Centro" ? "checked" : "")> 
                        @sucursal.Nombre
                    </label>
                }
            </div>

            <div class="distribucion-equipos">
                <span style="color:#d4af37">Centro:</span> Irvin, Fernando, Geovany<br>
                <span style="color:#d4af37">Plaza:</span> Diego, Erick
            </div>

            <div class="input-grupo">
                <label class="input-label">2. ¿Con quién deseas agendar?</label>
                <!-- Agregado name="BarberoId" -->
                <select id="selector-barbero" name="BarberoId" class="input-oscuro" onchange="actualizarResumen()">
                    <!-- JS inyecta esto -->
                </select>
            </div>

            <div style="background: rgba(212, 175, 55, 0.1); border-left: 3px solid #d4af37; padding: 10px; margin-top: 20px;">
                <p style="color: #ccc; font-size: 0.85rem; margin: 0; line-height: 1.4;">
                    <span style="color: #d4af37;"><strong>&#8987; Disponibilidad en Tiempo Real:</strong></span><br>
                    Si el barbero está ocupado cortando o tiene cita, ese horario se bloqueará automáticamente.
                </p>
            </div>
        </div>

        <!-- COLUMNA 2: SERVICIOS Y FECHAS -->
        <div class="col-servicios card">
            <h3 class="titulo-seccion">1. Selecciona tus servicios</h3>
            
            <!-- ACORDEÓN DINÁMICO DE SERVICIOS LEYENDO SQL -->
            @foreach (var categoria in categorias)
            {
                var idCategoriaVal = "cat-" + categoria.Replace(" ", "-").ToLower();
                
                <button type="button" class="categoria-btn" onclick="toggleCategoria('@idCategoriaVal')">
                    @categoria <span>&#9660;</span>
                </button>
                <div id="@idCategoriaVal" class="categoria-contenido @(categoria == "Cortes en Tendencia" ? "show" : "")">
                    
                    @foreach (var corte in cortes.Where(c => c.Categoria == categoria))
                    {
                        <label class="servicio-item">
                            <div style="display: flex; align-items: center;">
                                <!-- Agregado name="CortesSeleccionados" -->
                                <input class="form-check-input" type="checkbox" name="CortesSeleccionados" value="@corte.Id" onchange="toggleServicioCheckbox(this, @corte.Precio, '@corte.Nombre')">
                                <div>
                                    <strong>@corte.Nombre</strong>
                                    <p style="margin: 0; color: #aaa; font-size: 0.85rem;">@corte.Descripcion</p>
                                </div>
                            </div>
                            <div class="precio">$@corte.Precio</div>
                        </label>
                    }
                </div>
            }

            <h3 class="titulo-seccion" style="margin-top: 40px;">2. Fecha, Hora y Pago</h3>
            <div style="display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 15px;">
                <div class="input-grupo" style="flex: 1; min-width: 200px;">
                    <label class="input-label">Elige la fecha:</label>
                    <!-- Agregado name="FechaCita" -->
                    <input type="date" name="FechaCita" id="selector-fecha" class="input-oscuro" onchange="validarDisponibilidad()" required>
                </div>
                <div class="input-grupo" style="flex: 1; min-width: 200px;">
                    <label class="input-label">Elige la hora (10:00 a 20:00):</label>
                    <!-- Agregado name="HoraCita" -->
                    <input type="time" name="HoraCita" id="selector-hora" class="input-oscuro" min="10:00" max="20:00" value="10:00" onchange="validarDisponibilidad()" required>
                </div>
            </div>
            
            <div class="input-grupo">
                <label class="input-label">Método de Pago (Para asegurar el lugar):</label>
                <!-- Agregado name="MetodoPago" -->
                <select name="MetodoPago" id="selector-pago" class="input-oscuro" onchange="actualizarResumen()">
                    <option value="Efectivo (Pago en sucursal)">Efectivo (Pago en sucursal)</option>
                    <option value="Transferencia (Anticipo 50%)">Transferencia (Anticipo 50% para asegurar lugar)</option>
                </select>
            </div>
            
            <p id="alerta-ocupado" style="color: #ff4d4d; font-size: 0.95rem; display: none; margin-top: 15px; padding: 10px; background: rgba(255,0,0,0.1); border-left: 3px solid #ff4d4d;"> 
                <strong>Horario fuera de servicio u ocupado.</strong> Nuestro horario es de 10 AM a 8 PM. Verifica tu selección o el barbero ya tiene cita.
            </p>
        </div>

        <!-- COLUMNA 3: RESUMEN -->
        <div class="col-reserva card">
            <h3 class="titulo-seccion">Tu reserva</h3>
            <p style="color: #aaa; font-size: 0.9rem; margin: 5px 0;">SUCURSAL</p>
            <p id="resumen-sucursal" style="font-weight: bold; margin: 0 0 15px 0; font-size: 1.1rem; color: #fff;">Centro</p>
            
            <p style="color: #aaa; font-size: 0.9rem; margin: 5px 0;">BARBERO SELECCIONADO</p>
            <p id="resumen-barbero" style="font-weight: bold; margin: 0 0 15px 0; font-size: 1.1rem; color: #d4af37;">Cualquier barbero disponible</p>
            
            <p style="color: #aaa; font-size: 0.9rem; margin: 5px 0;">SERVICIOS</p>
            <p id="resumen-servicios" style="font-weight: bold; margin: 0 0 15px 0; font-size: 0.95rem; color: #fff;">Ningún servicio seleccionado</p>
            
            <p style="color: #aaa; font-size: 0.9rem; margin: 5px 0;">FECHA Y HORA</p>
            <p id="resumen-fecha-hora" style="font-weight: bold; margin: 0 0 15px 0; color: #fff;">Selecciona fecha y hora</p>
            
            <p style="color: #aaa; font-size: 0.9rem; margin: 5px 0;">MÉTODO DE PAGO</p>
            <p id="resumen-pago" style="font-weight: bold; margin: 0 0 20px 0; color: #4CAF50;">Efectivo (Pago en sucursal)</p>
            
            <hr style="border-color: #333; margin-bottom: 20px;">
            <div style="text-align: right; margin-bottom: 15px;">
                <div style="display: flex; justify-content: space-between; font-size: 1.3rem;">
                    <span style="color: white;">Total</span>
                    <span class="precio" id="resumen-total">$0</span>
                </div>
            </div>
            
            <!-- Asegurado type="submit" para que el formulario se envíe a SQL Server -->
            <button type="submit" class="btn-confirmar" id="btn-submit">Confirmar reserva</button>
        </div>
    </div>
</form>

<script>
    let carrito = [];
    
    // El JS inyecta el TEXTO en la UI, pero el select envía el VALOR (Id del barbero) a SQL Server
    const barberosPorSucursal = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(barberosPorSucursalData));

    function filtrarBarberos(barberoSeleccionadoPorUrl = null) {
        const sucursalElegida = document.querySelector('input[name="SucursalId"]:checked');
        const nombreSucursal = sucursalElegida.nextSibling.textContent.trim(); // "Centro" o "Plaza"
        const selectorBarbero = document.getElementById('selector-barbero');
        
        selectorBarbero.innerHTML = '';
        if (barberosPorSucursal[nombreSucursal]) {
            barberosPorSucursal[nombreSucursal].forEach(barbero => {
                let option = document.createElement('option');
                option.value = barbero.valor;
                option.text = barbero.nombre;
                selectorBarbero.appendChild(option);
            });
        }
        
        document.getElementById('resumen-sucursal').innerText = nombreSucursal;
        
        if (barberoSeleccionadoPorUrl && barberoSeleccionadoPorUrl !== 'Cualquier barbero') {
            for(let i=0; i<selectorBarbero.options.length; i++) {
                if(selectorBarbero.options[i].text.includes(barberoSeleccionadoPorUrl)) {
                    selectorBarbero.selectedIndex = i;
                    break;
                }
            }
        }
        actualizarResumen();
    }

    function toggleCategoria(idCategoria) {
        const contenido = document.getElementById(idCategoria);
        if (contenido.classList.contains('show')) { contenido.classList.remove('show'); }
        else { contenido.classList.add('show'); }
    }

    function toggleServicioCheckbox(checkbox, precio, nombreServicio) {
        let elemento = checkbox.closest('.servicio-item');
        if (checkbox.checked) {
            elemento.classList.add('selected');
            carrito.push({ nombre: nombreServicio, precio: precio });
        } else {
            elemento.classList.remove('selected');
            carrito = carrito.filter(s => s.nombre !== nombreServicio);
        }
        renderizarCarrito();
    }

    function renderizarCarrito() {
        let total = 0;
        carrito.forEach(item => { total += item.precio; });

        document.getElementById('resumen-servicios').innerHTML = carrito.length > 0 ? carrito.map(i => i.nombre).join('<br>') : 'Ningún servicio seleccionado';
        document.getElementById('resumen-total').innerText = '$' + total;
    }

    function actualizarResumen() {
        const selectorBarbero = document.getElementById('selector-barbero');
        document.getElementById('resumen-barbero').innerText = selectorBarbero.options[selectorBarbero.selectedIndex].text;
        document.getElementById('resumen-pago').innerText = document.getElementById('selector-pago').value;
        validarDisponibilidad();
    }

    function validarDisponibilidad() {
        const fechaVal = document.getElementById('selector-fecha').value;
        const horaVal = document.getElementById('selector-hora').value;
        const alerta = document.getElementById('alerta-ocupado');
        const btnSubmit = document.getElementById('btn-submit');
        const horaMinutos = parseInt(horaVal.replace(':', ''));
        
        let fueraDeHorario = horaMinutos < 1000 || horaMinutos > 2000;
        let ocupado = horaVal === "14:00"; // Simulación JS
        
        if (fueraDeHorario || ocupado) {
            alerta.style.display = 'block';
            btnSubmit.style.background = '#333';
            btnSubmit.style.color = '#666';
            btnSubmit.style.cursor = 'not-allowed';
            btnSubmit.innerText = fueraDeHorario ? 'Fuera de servicio' : 'Barbero Ocupado';
            btnSubmit.disabled = true;
        } else {
            alerta.style.display = 'none';
            btnSubmit.style.background = '#d4af37';
            btnSubmit.style.color = 'black';
            btnSubmit.style.cursor = 'pointer';
            btnSubmit.innerText = 'Confirmar reserva';
            btnSubmit.disabled = false;
        }
        
        if(fechaVal && horaVal) {
            const opciones = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' };
            const fechaObj = new Date(fechaVal + 'T00:00:00');
            document.getElementById('resumen-fecha-hora').innerText = fechaObj.toLocaleDateString('es-MX', opciones) + ', ' + horaVal + ' hrs';
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        const inputFecha = document.getElementById('selector-fecha');
        const hoy = new Date().toISOString().split('T')[0];
        inputFecha.value = hoy; 
        inputFecha.min = hoy;
        
        let barberoUrl = @Json.Serialize(barberoSeleccionado);
        let corteUrl = @Json.Serialize(corteSeleccionado);
        
        filtrarBarberos(barberoUrl);
        
        if(corteUrl) {
            let checkboxes = document.querySelectorAll('.form-check-input');
            checkboxes.forEach(cb => {
                if(cb.nextElementSibling.querySelector('strong').innerText.includes(corteUrl)) {
                    cb.checked = true;
                    toggleServicioCheckbox(cb, parseInt(cb.closest('.servicio-item').querySelector('.precio').innerText.replace('$','')), corteUrl);
                }
            });
        }
    });
</script>